# DIGO EVOLUTION — environment variables
# Copy to .env (never commit real secrets). All values are optional:
# the game is fully playable offline and falls back to a local profile.

# Port the Node server listens on (AppJet injects this automatically).
PORT=3000

# Comma separated allowed origins for the API (defaults to same-origin).
# ALLOWED_ORIGINS=https://your-domain.example

# Secret used to sign server-issued session tokens for Phantom wallet auth.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When unset, wallet sessions are still issued but signed with an ephemeral
# per-boot key, so sessions do not survive a restart.
AUTH_SECRET=

# Path to the JSON file used as the score / leaderboard store.
# Defaults to ./data/db.json inside the container.
DATA_FILE=./data/db.json
