# ---------------------------------------------------------------------------
# DIGO EVOLUTION - environment variables
# Copy to .env for local development. On AppJet hosting, add the same names in
# Settings -> Environment variables (values never belong in the repository).
# ---------------------------------------------------------------------------

# Port the Node server listens on. AppJet injects PORT automatically.
PORT=3000

# Secret used to sign wallet session tokens and reward receipts.
# Optional: when absent the server generates a random per-boot secret, which
# invalidates wallet sessions after a restart.
SESSION_SECRET=

# Solana cluster used by the (future) DIGO token integration. Display only -
# this build performs no on-chain transactions.
SOLANA_CLUSTER=devnet

# Public address of the DIGO token mint (display only, no transfers happen).
DIGO_TOKEN_MINT=

# Public RPC endpoint for read-only wallet balance display (optional).
SOLANA_RPC_URL=
