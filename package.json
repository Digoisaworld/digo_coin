{
  "name": "digo-evolution",
  "private": true,
  "version": "1.0.0",
  "description": "DIGO EVOLUTION - mobile 3D arcade survival game (React + TypeScript + Three.js)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node server/index.js",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
